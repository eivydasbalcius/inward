DATABASE_URL=postgres://user@localhost:5432/inward
PAYLOAD_SECRET=change-me
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Online booking (on by default). Payments via Paysera are switched on separately once connected.
BOOKING_ENABLED=true
PAYMENTS_ENABLED=false


# "Inward sesijos" calendar ID (Calendar settings → Integrate calendar)
# --- Google Calendar (OAuth "Prisijungti prie Google" in admin) ---
# Google Cloud → Google Auth Platform → Clients → Web application.
# Redirect URI: <NEXT_PUBLIC_SITE_URL>/api/google/oauth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# "Inward sesijos" calendar ID (Calendar settings → Integrate calendar)
GOOGLE_BOOKINGS_CALENDAR_ID=
# Random secret Google sends back with every push notification
GOOGLE_WEBHOOK_TOKEN=
# Public HTTPS URL of the site (production domain or a cloudflared tunnel locally) – needed for push notifications
PUBLIC_URL=

TZ_STUDIO=Europe/Vilnius
